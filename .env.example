# Environment variables this site reads, and why each one exists.
#
# Committed and secret-free by convention: every value here is a placeholder or
# a public value. Real secrets live in the Netlify UI, scoped to a context, and
# never in this file or any other file in the repository.
#
# Anything prefixed NEXT_PUBLIC_ is compiled into the browser bundle. That is
# not a warning about these particular values, all of which are public, but
# about the rule: a secret in a NEXT_PUBLIC_ variable is a published secret, and
# marking it secret in Netlify does not change that.

# ---------------------------------------------------------------------------
# The site

# Used to build absolute links in email and in structured data. Read rather than
# derived from the request, because on Netlify the request carries the deploy's
# own host: a link built from it points at main--<site>.netlify.app, which stops
# resolving on the next deploy.
NEXT_PUBLIC_SITE_URL=https://blockfestafrica.com

# Where campaign mail invites a reply, and the address shown to a creator who
# has lost their link.
NEXT_PUBLIC_CONTACT_EMAIL=partnership@blockfestafrica.com

# ---------------------------------------------------------------------------
# The campaign

# Opens registration and submission before the campaign's start date, for
# testing against production. Compared against the exact string "true", so
# anything unset, misspelt or truthy-ish leaves the gate shut.
#
# One flag rather than a server one and a client one, because two flags can
# disagree and the failure is silent: a form that renders against an endpoint
# that refuses it, or worse, the reverse.
#
# It is compiled into the browser bundle, so changing it needs a redeploy. After
# 14 September it stops mattering: the date has passed and the gate is open on
# its own.
NEXT_PUBLIC_CAMPAIGN_GATE_OPEN=false

# ---------------------------------------------------------------------------
# The database
#
# There is deliberately no DATABASE_URL in production. Netlify DB injects the
# connection into the function environment under its own name and the supported
# way to reach it is the @netlify/database resolver, not a variable name you
# guessed. Guessing is what went wrong the first time: the client read
# NETLIFY_DATABASE_URL, which is not the name Netlify uses, so every call to the
# registration endpoint failed in production while every local check passed.
#
# This one is an override, for pointing a local run at a database you own.
# DATABASE_URL=postgres://user:password@host/db?sslmode=require

# ---------------------------------------------------------------------------
# Transactional email (ZeptoMail)

# The Send Mail token, from the Mail Agent. A production secret in Netlify,
# never here. Accepts the value with or without the "Zoho-enczapikey " prefix,
# because the console shows it one way and every code sample the other.
ZEPTOMAIL_TOKEN=Zoho-enczapikey xxxxxxxxxxxxxxxxxxxx

# The From address. Must be on a domain verified in ZeptoMail.
ZEPTOMAIL_FROM=noreply@blockfestafrica.com

# Regional, and the single most confusing thing to get wrong: an account lives
# in exactly one data centre, and posting to the wrong one returns 401 with a
# message about the key. Only set this if the account moves.
# ZEPTOMAIL_HOST=https://api.zeptomail.eu/v1.1/email

# ---------------------------------------------------------------------------
# Analytics (Umami, self-hosted)
#
# No cookies and no personal data, which is why it is loaded on marketing pages
# and deliberately not on /admin.

NEXT_PUBLIC_UMAMI_SRC=https://analytics.example.com/script.js
NEXT_PUBLIC_UMAMI_WEBSITE_ID=00000000-0000-0000-0000-000000000000
NEXT_PUBLIC_UMAMI_SHARE_URL=

# ---------------------------------------------------------------------------
# Social, used for links and structured data

NEXT_PUBLIC_TWITTER_HANDLE=BlockfestAfrica
NEXT_PUBLIC_INSTAGRAM_HANDLE=blockfestafrica
NEXT_PUBLIC_LINKEDIN_PAGE=https://www.linkedin.com/company/blockfest-africa
NEXT_PUBLIC_YOUTUBE_CHANNEL=

# ---------------------------------------------------------------------------
# Search

# The token Google Search Console asks for to prove control of the domain. Only
# needed when re-verifying; the DNS record already in place does the same job.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ---------------------------------------------------------------------------
# Content flags

# Hides transport details on the event page until they are settled.
SHOW_TRANSPORT_DETAILS=false
