# Copy to .env.local and fill in real values. This file is committed, so it
# must never contain a real secret, password or private data URL.

# SEO and Analytics Configuration
NEXT_PUBLIC_SITE_URL=https://blockfestafrica.com

# Umami Analytics Configuration
NEXT_PUBLIC_UMAMI_WEBSITE_ID=your-umami-website-id
NEXT_PUBLIC_UMAMI_SRC=https://cloud.umami.is/script.js
NEXT_PUBLIC_UMAMI_SHARE_URL=https://cloud.umami.is/share/your-share-id/blockfestafrica.com

# Analytics Dashboard — the password gating /insights
INSIGHTS_PASSWORD=your-insights-password

# Published Google Sheet holding guest registrations, as CSV.
# This feeds /insights and contains attendee personal data, so the real URL
# belongs in .env.local only.
GOOGLE_SHEETS_CSV_URL=https://docs.google.com/spreadsheets/d/e/your-published-sheet-id/pub?output=csv

# Social Media
NEXT_PUBLIC_TWITTER_HANDLE=@blockfestafrica
NEXT_PUBLIC_INSTAGRAM_HANDLE=blockfestival_africa
NEXT_PUBLIC_LINKEDIN_PAGE=company/blockfest-africa
NEXT_PUBLIC_YOUTUBE_CHANNEL=@blockchainfestivalafrica

# Site Verification
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your-google-verification-code

# Contact Information
NEXT_PUBLIC_CONTACT_EMAIL=partnership@blockfestafrica.com
